{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.84",
          "--isolated",
          "--no-sandbox",
          "--browser",
          "chromium",
          "--executable-path",
          "/usr/bin/chromium"
        ],
        "environment": {
          "PLAYWRIGHT_MCP_HEADLESS": "0"
        }
      }
    }
  }
}
